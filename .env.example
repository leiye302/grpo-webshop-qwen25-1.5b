GRPO_PYTHON=python
GRPO_GPUS=0,1,2,3
GRPO_CPUS=32
# Activate the documented Python3.10 / Java11 environment first.
# JAVA_HOME is usually CONDA_PREFIX if OpenJDK was installed there.
_JAVA_OPTIONS="-XX:+UseSerialGC -Xss512k -Xmx1g"
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
DATASETS_MAX_WORKERS=1
# Optional existing short writable directory for Ray sockets.
# GRPO_RUNTIME_ROOT=/tmp
